# Copia este fichero a .env y rellena los valores.
# .env está ignorado por git: nunca se versiona.

# --- Supabase: configuración pública ---------------------------------------
# Estas tres llegan al navegador. Son públicas por diseño y no son secretas.
VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_PROJECT_ID=<id-del-proyecto>
VITE_SUPABASE_PUBLISHABLE_KEY=<clave-publicable-anon>

# Las mismas, sin prefijo VITE_, para las server functions.
SUPABASE_URL=https://<id-del-proyecto>.supabase.co
SUPABASE_PROJECT_ID=<id-del-proyecto>
SUPABASE_PUBLISHABLE_KEY=<clave-publicable-anon>

# --- Supabase: secreto de servidor -----------------------------------------
# NUNCA con prefijo VITE_. Salta la RLS: si acaba en el navegador, se acabó.
# Solo se define en el entorno de despliegue y en el .env local.
SUPABASE_SERVICE_ROLE_KEY=<clave-service-role>

# --- Correo saliente (SMTP) -------------------------------------------------
# Para Resend: host smtp.resend.com, puerto 465, usuario "resend" y la clave de
# API como contraseña. La dirección remitente se configura por tienda en la
# aplicación, no aquí.
#
# SMTP_CLAVE es un secreto: solo en el entorno del despliegue y en el .env
# local. Nunca en una tabla, ni en el frontend, ni en un commit.
SMTP_HOST=smtp.resend.com
SMTP_PUERTO=465
SMTP_USUARIO=resend
SMTP_CLAVE=<clave-de-api-del-proveedor>

# --- Lector de facturas de compra (opcional) --------------------------------
# Sin esta clave la pantalla de Compras sigue funcionando: las compras se dan
# de alta a mano. Con ella, se sube el PDF o la foto y la lee un modelo.
#
# Es un secreto: solo en el entorno del despliegue y en el .env local. Nunca
# con prefijo VITE_ — llegaría al navegador y quedaría a la vista de cualquiera.
ANTHROPIC_API_KEY=<clave-de-api>

# Opcional. Por defecto claude-sonnet-5.
# MODELO_LECTURA=claude-sonnet-5
