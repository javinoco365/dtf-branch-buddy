# Copia este fichero a .env y rellena los valores.
# .env está ignorado por git: nunca se versiona.

# --- Supabase: configuración pública ---------------------------------------
# Estas tres llegan al navegador. Son públicas por diseño y no son secretas.
VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
VITE_SUPABASE_PROJECT_ID=<id-del-proyecto>
VITE_SUPABASE_PUBLISHABLE_KEY=<clave-publicable-anon>

# Las mismas, sin prefijo VITE_, para las server functions.
SUPABASE_URL=https://<id-del-proyecto>.supabase.co
SUPABASE_PROJECT_ID=<id-del-proyecto>
SUPABASE_PUBLISHABLE_KEY=<clave-publicable-anon>

# --- Supabase: secreto de servidor -----------------------------------------
# NUNCA con prefijo VITE_. Salta la RLS: si acaba en el navegador, se acabó.
# Solo se define en el entorno de despliegue y en el .env local.
SUPABASE_SERVICE_ROLE_KEY=<clave-service-role>
